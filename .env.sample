# Copy to .env and adjust. Every value is optional; the defaults are shown.
# Camera list, layouts and tuning live in data/config.json (edited from the UI), not here.

# Host port the web UI is published on -> http://<host>:APP_PORT
APP_PORT=8003

# Docker container name
CONTAINER_NAME=cctv-mini

# Timezone: folder dates and the daily timelapse schedule use this zone
TZ=Asia/Jakarta

# Default subnet for "Find RTSP on network" on the Config page
SCAN_SUBNET=192.168.1.0/24

# User/group the app runs as; must own the folders below (check with: id -u / id -g)
PUID=1000
PGID=1000

# Host folders. DATA_PATH holds config.json + thumbnails.
# Pictures and timelapse can live elsewhere, e.g. a bigger disk or NAS mount.
DATA_PATH=./data
PICTURES_PATH=./data/cctv
TIMELAPSE_PATH=./data/timelapse
